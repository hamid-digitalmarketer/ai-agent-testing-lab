# ai-agent-testing-lab environment template.
#
# The lab runs in rule-based demo mode by default: zero API keys, zero cost.
# These variables are only used when you intentionally point the harness at a
# live provider to evaluate a real model-backed agent. Never commit real keys.

# Provider selection: mock | openai | anthropic | local
LAB_PROVIDER=mock

# Live provider credentials (leave blank in demo mode)
LAB_OPENAI_API_KEY=
LAB_ANTHROPIC_API_KEY=

# Cost and safety caps
LAB_MAX_COST_USD=0.0
LAB_MAX_LATENCY_MS=5000
LAB_MAX_RUNS_PER_CASE=10

# CI integration
LAB_CI_STEP_SUMMARY_PATH=
